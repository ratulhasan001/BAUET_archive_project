SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset to use SQLite. Example for PostgreSQL:
# DATABASE_URL=postgres://archive_user:password@localhost:5432/bauet_archive_rest

# Origin(s) the frontend is served from.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500

# Console backend prints activation emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
