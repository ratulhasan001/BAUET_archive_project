SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset to use SQLite. Example for PostgreSQL:
# DATABASE_URL=postgres://archive_user:password@localhost:5432/bauet_archive

# Console backend prints emails (OTP, activation links) to the terminal.
# Switch to SMTP to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
